      "id": "f670c5a4-3100-4112-bf73-126e0d4f68a6",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "NwXITctHDpwpF0od",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of $input.all()) {\n  const text = item.json.text;\n\n  // Ignore null / empty results\n  if (!text || text.trim() === 'null') {\n    continue;\n  }\n\n  try {\n    // Parse the JSON string returned by the LLM\n    const color = JSON.parse(text);\n\n    // Make sure it's a valid color object\n    if (\n      color &&\n      typeof color === 'object' &&\n      color.name &&\n      color.Hex &&\n      color.RGB\n    ) {\n      output.push({\n        json: {\n          name: color.name,\n          Hex: color.Hex,\n          RGB: color.RGB\n        }\n      });\n    }\n  } catch (error) {\n    // Ignore malformed LLM responses\n    continue;\n  }\n}\n\nreturn output;\n"
      },
